DATABASE_URL="file:./dev.db"
# Required for personal accounts. Keep real values in .env.local or deployment secrets.
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Optional public origin when a reverse proxy reports an internal host.
AUTH_URL=""
# Optional. Without it, poster upload switches to editable manual entry.
OPENAI_API_KEY=""
# Optional vision model override.
OPENAI_VISION_MODEL="gpt-4.1-mini"
# Optional Smart Search interpretation model override.
OPENAI_SEARCH_MODEL="gpt-4.1-mini"
