generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id                   String   @id @default(cuid())
  title                String
  organizer            String
  description          String
  date                 String
  startTime            String
  endTime              String
  venue                String
  venueId              String?
  submissionKey        String?  @unique
  category             String
  tagsJson             String
  registrationDeadline String?
  expectedAudience     Int?
  popularity           Int      @default(0)
  isDemo               Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  savedBy              SavedEvent[]
  venueRecord          Venue?   @relation(fields: [venueId], references: [id])

  @@index([date, startTime])
  @@index([category])
  @@index([venueId])
}

model Venue {
  id             String  @id @default(cuid())
  name           String  @unique
  building       String
  area           String
  capacity       Int
  type           String
  hasProjector   Boolean
  hasAudioSystem Boolean
  hasStage       Boolean
  indoor         Boolean
  accessible     Boolean
  latitude       Float?
  longitude      Float?
  description    String?
  isDemo         Boolean @default(true)
  events         Event[]
}

model EventSource {
  id               String   @id @default(cuid())
  sourceType       String
  label            String
  sourceData       String
  extractedJson    String?
  status           String   @default("NEW")
  publishedEventId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
}

model StudentProfile {
  id                    String       @id
  userId                String?      @unique
  name                  String
  interestsJson         String
  categoryPreferencesJson String
  organizerAffinityJson String
  saved                 SavedEvent[]
  user                  User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  role          String          @default("STUDENT")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accounts      Account[]
  sessions      Session[]
  profile       StudentProfile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SavedEvent {
  studentId String
  eventId   String
  preference String @default("SAVED")
  savedAt   DateTime @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([studentId, eventId])
}
