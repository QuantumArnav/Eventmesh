generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id                   String   @id @default(cuid())
  title                String
  organizer            String
  description          String
  date                 String
  startTime            String
  endTime              String
  venue                String
  venueId              String?
  submissionKey        String?  @unique
  category             String
  tagsJson             String
  registrationDeadline String?
  expectedAudience     Int?
  popularity           Int      @default(0)
  isDemo               Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  savedBy              SavedEvent[]
  venueRecord          Venue?   @relation(fields: [venueId], references: [id])

  @@index([date, startTime])
  @@index([category])
  @@index([venueId])
}

model Venue {
  id             String  @id @default(cuid())
  name           String  @unique
  building       String
  area           String
  capacity       Int
  type           String
  hasProjector   Boolean
  hasAudioSystem Boolean
  hasStage       Boolean
  indoor         Boolean
  accessible     Boolean
  latitude       Float?
  longitude      Float?
  description    String?
  isDemo         Boolean @default(true)
  events         Event[]
}

model EventSource {
  id               String   @id @default(cuid())
  sourceType       String
  label            String
  sourceData       String
  extractedJson    String?
  status           String   @default("NEW")
  publishedEventId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
}

model StudentProfile {
  id                    String       @id
  name                  String
  interestsJson         String
  categoryPreferencesJson String
  organizerAffinityJson String
  saved                 SavedEvent[]
}

model SavedEvent {
  studentId String
  eventId   String
  preference String @default("SAVED")
  savedAt   DateTime @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([studentId, eventId])
}
